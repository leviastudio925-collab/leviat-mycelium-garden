{
  "name": "bloom-path",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "dev:cloudflare": "npm run build && wrangler dev",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:scene": "node --test tests/growth-origins.test.mjs tests/guided-growth.test.mjs tests/ongoing-growth.test.mjs tests/post-timeline-camera.test.mjs",
    "test:api": "node --test tests/runtime-config.test.mjs tests/client-config.test.mjs tests/admin-api.test.mjs",
    "update:config": "node scripts/publish-content.mjs config",
    "update:model": "node scripts/publish-content.mjs model",
    "osc": "node scripts/osc-bridge.mjs",
    "osc:trigger": "node scripts/send-osc-start.mjs",
    "test:osc": "node --test tests/osc-bridge.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0",
    "vite": "6.4.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  }
}
